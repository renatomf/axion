{
  "ifResourceExists": "FAIL",
  "clients": [
    {
      "clientId": "finaxis-test",
      "description": "Tests only: issues core access tokens with the password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "finaxis-core audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "finaxis-core",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "finaxis-other",
      "description": "Tests only: a client of the realm the core does not accept",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "finaxis-core audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "finaxis-core",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "member.test",
      "email": "member@example.test",
      "emailVerified": true,
      "firstName": "Member",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "synthetic-password-1",
          "temporary": false
        }
      ]
    }
  ]
