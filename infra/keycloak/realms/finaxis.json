{
  "realm": "finaxis",
  "displayName": "Finaxis",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "browserFlow": "mfa browser",
  "webAuthnPolicyRpEntityName": "Finaxis",
  "authenticationFlows": [
    {
      "alias": "mfa browser",
      "description": "Browser login with a password and a second factor for every user",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "mfa browser forms"
        }
      ]
    },
    {
      "alias": "mfa browser forms",
      "description": "Password, then a second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "mfa second factor"
        }
      ]
    },
    {
      "alias": "mfa second factor",
      "description": "A passkey if the user has one, TOTP otherwise",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "mfa passkey"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "mfa totp"
        }
      ]
    },
    {
      "alias": "mfa passkey",
      "description": "Runs only for a user with a passkey",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "webauthn-authenticator"
        }
      ]
    },
    {
      "alias": "mfa totp",
      "description": "Runs when no passkey was used; a user without TOTP enrolls it",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-sub-flow-executed",
          "authenticatorConfig": "mfa passkey not used"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "mfa passkey not used",
      "config": {
        "flow_to_check": "mfa passkey",
        "check_result": "not-executed"
      }
    }
  ],
  "clients": [
    {
      "clientId": "finaxis-console",
      "name": "Finaxis console",
      "description": "The console's backend for frontend; it logs members in and calls the core's /internal API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FINAXIS_CONSOLE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "finaxis-core audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "finaxis-core",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
