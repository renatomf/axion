# Local development settings for compose.yaml. Copy this file to .env
# (git-ignored) in this directory. Local, synthetic data only: never reuse
# these values outside your machine.
AXION_DB_PASSWORD=axion-local

# Password of axion_app, the role the core service logs in as.
AXION_APP_DB_PASSWORD=axion-app-local

# Host port for PostgreSQL; change it if 5432 is already taken on your machine.
AXION_DB_PORT=5432

# Password of Keycloak's own database role (profile auth).
KEYCLOAK_DB_PASSWORD=keycloak-local

# Password of Keycloak's temporary administrator, user admin (profile auth).
KEYCLOAK_ADMIN_PASSWORD=admin-local

# Host port for Keycloak; change it if 8180 is already taken on your machine.
KEYCLOAK_PORT=8180

# Client secret of the console's backend in the axion realm (profile auth).
AXION_CONSOLE_CLIENT_SECRET=console-local

# Password of the rails simulator's own database role (profile rails).
RAILS_SIMULATOR_DB_PASSWORD=rails-simulator-local

# Bearer token of the rails simulator's operator API, 32 characters or more (profile rails).
RAILS_SIMULATOR_OPERATOR_TOKEN=rails-simulator-operator-local-only

# The rails simulator's Ed25519 signing key is not here: `just up` generates a
# pair for each machine and adds RAILS_SIMULATOR_SIGNING_KEY_ID, _PRIVATE_KEY
# and _PUBLIC_KEY to .env (profile rails).

# Host port for the rails simulator; change it if 8090 is already taken (profile rails).
RAILS_SIMULATOR_PORT=8090

# Ports of localhost where your own server receives webhooks from the core,
# comma-separated, such as 4000; read by the core's local profile only
# (docs/api/webhooks.md). Empty: none.
AXION_WEBHOOK_LOCAL_PORTS=
